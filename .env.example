# Server-side email delivery
QUOTE_TO_EMAIL=movefurniturewithkings@gmail.com
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-google-app-password

# Optional Resend fallback, only useful after verifying a sending domain
RESEND_API_KEY=
QUOTE_FROM_EMAIL=

# Google Places API (New)
GOOGLE_PLACES_API_KEY=xxxxxxxxx
GOOGLE_PLACE_ID=ChIJxxxxxxxxx

# Official link copied from Google Business Profile > Ask for reviews
NEXT_PUBLIC_GOOGLE_REVIEW_URL=https://g.page/r/your-review-link/review

# Replace with the final production domain after hosting is selected
NEXT_PUBLIC_SITE_URL=http://localhost:3000
